# ==========================================
# CẤU HÌNH DATABASE (POSTGRESQL)
# ==========================================
POSTGRES_USER=ictu_ai_judge
POSTGRES_PASSWORD=ictu_ai_judge_password
POSTGRES_DB=ictu_ai_judge
DATABASE_URL=postgresql+psycopg2://ictu_ai_judge:ictu_ai_judge_password@db:5432/ictu_ai_judge

# ==========================================
# CẤU HÌNH REDIS & CELERY
# ==========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==========================================
# CẤU HÌNH S3 STORAGE (MINIO)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ictu-ai-judge-bucket

# ==========================================
# CẤU HÌNH BẢO MẬT & JWT (BACKEND)
# ==========================================
SECRET_KEY=super-secret-key-change-it-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CẤU HÌNH MÔI TRƯỜNG & GOOGLE OAUTH
# ==========================================
APP_ENV=development
DEBUG=true
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
