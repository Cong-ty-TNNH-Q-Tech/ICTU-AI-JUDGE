# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Copy file nay thanh .env va dien gia tri tuong ung
# Dung cho local dev (npm run dev).
# Khi chay bang Docker, gia tri nay duoc doc tu root .env qua docker-compose build args.

# Google OAuth Client ID (lay tu Google Cloud Console)
# Xem huong dan: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
