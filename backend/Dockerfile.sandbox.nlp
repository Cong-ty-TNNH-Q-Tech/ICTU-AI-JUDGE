FROM python:3.11-slim

WORKDIR /tmp

# Install system dependencies for NLP tasks
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --default-timeout=1000 --no-cache-dir \
    pandas \
    scikit-learn \
    numpy \
    torch \
    transformers \
    huggingface_hub \
    sentencepiece \
    sacrebleu \
    evaluate \
    rouge-score \
    jiwer \
    spacy \
    nltk

# Run non-root user
RUN useradd -m sandboxuser
USER sandboxuser
